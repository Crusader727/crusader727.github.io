{
  "// note": "Скопируй в .mcp.json и подставь реальные ключи вместо REPLACE_*. Реальный .mcp.json в .gitignore — в публичный репозиторий не попадёт.",
  "mcpServers": {
    "playwright": {
      "command": "/Users/crusader/.nvm/versions/node/v24.14.0/bin/npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "puppeteer": {
      "command": "/Users/crusader/.nvm/versions/node/v24.14.0/bin/npx",
      "args": ["-y", "puppeteer-mcp-server"]
    },
    "context-mode": {
      "command": "/Users/crusader/.nvm/versions/node/v24.14.0/bin/npx",
      "args": ["-y", "context-mode"]
    },
    "ruflo": {
      "command": "/Users/crusader/.nvm/versions/node/v24.14.0/bin/npx",
      "args": ["-y", "ruflo@latest", "mcp", "start"]
    },
    "context7": {
      "command": "/Users/crusader/.nvm/versions/node/v24.14.0/bin/npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "REPLACE_WITH_CONTEXT7_KEY"
      }
    },
    "magic-21st": {
      "command": "/Users/crusader/.nvm/versions/node/v24.14.0/bin/npx",
      "args": ["-y", "@21st-dev/magic@latest", "API_KEY=REPLACE_WITH_21ST_KEY"]
    }
  }
}
